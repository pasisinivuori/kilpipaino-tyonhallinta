  "srcDoc": "<html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}html,body{margin:0;height:100%;font-family:Inter,system-ui,-apple-system,sans-serif;background:#F3F4F6;overflow:hidden}.wrap{display:flex;flex-direction:column;height:100%}.bar{display:flex;gap:8px;padding:10px;background:#FFFFFF;border-bottom:1px solid #E3E5E8;flex-wrap:wrap;align-items:center}button{font:600 15px Inter,system-ui,sans-serif;padding:11px 16px;border-radius:8px;border:1px solid #D1D5DB;background:#F3F4F6;color:#231F20;cursor:pointer}button:active{background:#E5E7EB}button.main{background:#22C55E;border-color:#16A34A;color:#FFFFFF}button.warn{background:#FFFFFF;color:#B4232A;border-color:#E5E7EB}.sep{flex:1}.kyna{display:flex;gap:6px;align-items:center;padding-left:4px}.sw{width:26px;height:26px;border-radius:50%;border:2px solid #FFFFFF;box-shadow:0 0 0 1px #D1D5DB;cursor:pointer}.sw.on{box-shadow:0 0 0 2px #231F20}.alue{flex:1;position:relative;background:#FFFFFF;margin:10px;border:1px solid #E3E5E8;border-radius:8px;overflow:hidden}canvas{position:absolute;inset:0;width:100%;height:100%;touch-action:none;display:block}.vihje{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#9CA3AF;font-size:15px;pointer-events:none;text-align:center;padding:20px}</style></head><body><div class=\"wrap\"><div class=\"bar\"><button id=\"kuva\">Ota kuva</button><button id=\"tyhja\">Tyhjä pohja</button><button id=\"kumoa\">Kumoa</button><button class=\"warn\" id=\"pyyhi\">Tyhjennä</button><div class=\"kyna\"><span class=\"sw on\" data-v=\"#111827\" style=\"background:#111827\"></span><span class=\"sw\" data-v=\"#DC2626\" style=\"background:#DC2626\"></span><span class=\"sw\" data-v=\"#2563EB\" style=\"background:#2563EB\"></span><button id=\"paksuus\">Viiva: ohut</button></div><div class=\"sep\"></div><button class=\"main\" id=\"tallenna\">Tallenna liitteeksi</button></div><div class=\"alue\" id=\"alue\"><canvas id=\"c\"></canvas><div class=\"vihje\" id=\"vihje\">Ota kuva asiakkaan mallista tai piirrä sormella / kynällä</div></div></div><input type=\"file\" id=\"tied\" accept=\"image/*\" style=\"display:none\"><script>var c=document.getElementById(\"c\"),ctx=c.getContext(\"2d\"),alue=document.getElementById(\"alue\");var bg=null,vedot=[],nyt=null,vari=\"#111827\",leveys=3,dpr=Math.min(window.devicePixelRatio||1,2);function koko(){var r=alue.getBoundingClientRect();if(!r.width||!r.height){return;}var w=Math.round(r.width*dpr),h=Math.round(r.height*dpr);if(w===c.width&&h===c.height){return;}c.width=w;c.height=h;piirra();}function piirra(){if(!c.width||!c.height){return;}ctx.setTransform(1,0,0,1,0,0);ctx.fillStyle=\"#FFFFFF\";ctx.fillRect(0,0,c.width,c.height); if(bg){var s=Math.min(c.width/bg.width,c.height/bg.height);var w=bg.width*s,h=bg.height*s;ctx.drawImage(bg,(c.width-w)/2,(c.height-h)/2,w,h);} ctx.lineCap=\"round\";ctx.lineJoin=\"round\"; var k=Math.min(c.width,c.height)/700; vedot.forEach(function(v){var lw=Math.max(2,v.w*dpr*k);ctx.strokeStyle=v.c;ctx.lineWidth=lw;ctx.fillStyle=v.c;  if(v.p.length===1){ctx.beginPath();ctx.arc(v.p[0].x*c.width,v.p[0].y*c.height,lw/2,0,6.2832);ctx.fill();return;}  ctx.beginPath();v.p.forEach(function(p,i){var x=p.x*c.width,y=p.y*c.height;i?ctx.lineTo(x,y):ctx.moveTo(x,y);});ctx.stroke();}); document.getElementById(\"vihje\").style.display=(bg||vedot.length)?\"none\":\"flex\";}function pos(e){var r=c.getBoundingClientRect();return {x:(e.clientX-r.left)/r.width,y:(e.clientY-r.top)/r.height};}c.addEventListener(\"pointerdown\",function(e){e.preventDefault();koko();try{c.setPointerCapture(e.pointerId);}catch(err){}nyt={c:vari,w:leveys,p:[pos(e)]};vedot.push(nyt);piirra();});c.addEventListener(\"pointermove\",function(e){if(!nyt)return;e.preventDefault();nyt.p.push(pos(e));piirra();});function loppu(){nyt=null;}c.addEventListener(\"pointerup\",loppu);c.addEventListener(\"pointercancel\",loppu);document.getElementById(\"kumoa\").onclick=function(){vedot.pop();piirra();};document.getElementById(\"pyyhi\").onclick=function(){vedot=[];bg=null;piirra();};document.getElementById(\"tyhja\").onclick=function(){bg=null;vedot=[];piirra();};document.getElementById(\"kuva\").onclick=function(){document.getElementById(\"tied\").click();};document.getElementById(\"paksuus\").onclick=function(){var t=[3,7,14],i=t.indexOf(leveys);leveys=t[(i+1)%3];this.textContent=\"Viiva: \"+[\"ohut\",\"keski\",\"paksu\"][t.indexOf(leveys)];};[].forEach.call(document.querySelectorAll(\".sw\"),function(s){s.onclick=function(){vari=s.getAttribute(\"data-v\");[].forEach.call(document.querySelectorAll(\".sw\"),function(o){o.className=\"sw\";});s.className=\"sw on\";};});document.getElementById(\"tied\").onchange=function(e){var f=e.target.files&&e.target.files[0];if(!f)return;var rd=new FileReader();rd.onload=function(){var im=new Image();im.onload=function(){bg=im;vedot=[];koko();piirra();};im.src=rd.result;};rd.readAsDataURL(f);e.target.value=\"\";};document.getElementById(\"tallenna\").onclick=function(){if(!bg&&!vedot.length){return;} var max=1400,s=Math.min(1,max/Math.max(c.width,c.height)); var o=document.createElement(\"canvas\");o.width=Math.round(c.width*s);o.height=Math.round(c.height*s); o.getContext(\"2d\").drawImage(c,0,0,o.width,o.height); var d=bg?o.toDataURL(\"image/jpeg\",0.85):o.toDataURL(\"image/png\"); parent.postMessage(\"piirros:\"+Date.now()+\";\"+d,\"*\"); bg=null;vedot=[];piirra();};if(window.ResizeObserver){new ResizeObserver(koko).observe(alue);}window.addEventListener(\"resize\",koko);setInterval(koko,700);koko();</script></body></html>",
